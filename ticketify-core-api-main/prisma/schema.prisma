generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TechnicianPresence {
  ONLINE
  BUSY
  OFFLINE
}

model User {
  id                     String                 @id @default(cuid())
  crm_user_id            String                 @unique
  email                  String                 @unique
  name                   String?              
  phone                  String?
  password               String
  user_location_tracking UserLocationTracking[]
  availability           Boolean                @default(false)
  /// Deactivated accounts cannot log in and their tokens stop working.
  is_active              Boolean                @default(true)
  /// Bumped on logout, password change and deactivation to revoke issued tokens.
  token_version          Int                    @default(0)
  presence               TechnicianPresence     @default(OFFLINE)
  busy_comment           String?
  busy_until             DateTime?
  /// Per-user UI preferences for the admin panel (theme, density, start page…).
  preferences            Json?
  tracking_device        TrackingDevice?
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  user_log               UserLog[]
  user_tickets            UserTicket[]
  feedbacks               UserFeedback[]
  role                   Role                   @relation(fields: [role_id], references: [id])
  role_id                String

  @@map("users")

  
}

model Role {
  id         String @id @default(cuid())
  name       String    @db.VarChar()
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt()
  deleted_at DateTime? @db.Timestamp()
  User       User[]
  
  @@map("roles")
}


enum UserAvailability {
  AVAILABLE
  UNAVAILBALE
  OFFLINE
  BREAK
}

model UserLocationTracking {
  id         String   @id @default(cuid())
  user_id    String
  latitude   Float
  longitude  Float
  /// Reported horizontal accuracy in metres; null for older app builds.
  accuracy   Float?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])

  @@index([user_id, created_at(sort: Desc)])
  @@map("user_location_tracking")
}

/// Traccar Client device identifier per technician. Kept off the users table so
/// user payloads never expose it: anyone holding it can post that user's location.
model TrackingDevice {
  id         String   @id @default(cuid())
  user_id    String   @unique
  device_id  String   @unique
  /// Last time Traccar Client contacted the server with this id, stored or not (off shift, filtered).
  last_seen_at DateTime?
  /// Traccar motion state from the last post; false while stop detection holds the phone stationary.
  is_moving    Boolean?
  /// When is_moving last changed, e.g. when the technician arrived on site.
  motion_since DateTime?
  battery_level Int?
  is_charging  Boolean?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("tracking_devices")
}

model UserTicket {
  id         String   @id @default(cuid())
  user_id    String
  ticket_id  String
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
  ticket     Tickets  @relation(fields: [ticket_id], references: [id])

}

model Tickets {
  id          String      @id @default(cuid())
  crm_id      String      @unique
  number      String
  description String
  state      String
  contact_id String
  priority  String
  created_at  DateTime    @default(now())
  ticket_log  TicketLog[]
  user_tickets UserTicket[]
}

model UserLog {
  id         String   @id @default(cuid())
  user_id    String
  log        String
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
}

model TicketLog {
  id         String   @id @default(cuid())
  ticket_id  String
  log        String
  created_at DateTime @default(now())
  ticket     Tickets  @relation(fields: [ticket_id], references: [id])
}

model UserFeedback {
  id         String   @id @default(cuid())
  user_id    String
  feedback   String
  rating     Int
  ticket_id  String
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
}

model NotificationTemplate {
  id            String   @id @default(cuid())
  trigger_key   String   @unique
  body_template String
  enabled       Boolean  @default(true)
  version       Int      @default(1)
  updated_at    DateTime @updatedAt

  @@map("notification_templates")
}

model ChargeCatalogItem {
  id             String   @id @default(cuid())
  code           String   @unique
  label          String
  amount_mvr     Decimal  @db.Decimal(10, 2)
  active         Boolean  @default(true)
  effective_from DateTime @default(now())

  @@map("charge_catalog_items")
}

model TicketSchedule {
  id                 String   @id @default(cuid())
  crm_ticket_id      String
  scheduled_at       DateTime
  technician_user_id String
  sms_sent           Boolean  @default(false)
  idempotency_key    String?  @unique
  created_at         DateTime @default(now())

  @@map("ticket_schedules")
}

model AssignmentPolicy {
  id         String  @id @default(cuid())
  department String
  region     String?
  queue_id   String?
  mode       String
  is_default Boolean @default(false)

  @@map("assignment_policies")
}

model IntegrationAuditLog {
  id              String   @id @default(cuid())
  entity_type     String
  entity_id       String
  action          String
  actor_user_id   String?
  old_state       Json?
  new_state       Json?
  crm_sync_ok     Boolean?
  error_message   String?
  idempotency_key String?  @unique
  created_at      DateTime @default(now())

  @@map("integration_audit_logs")
}

model SystemConfig {
  key   String @id
  value Json

  @@map("system_config")
}

enum TicketInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum TicketPaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

model TicketInvoice {
  id                 String              @id @default(cuid())
  invoice_number     String              @unique
  crm_ticket_id      String
  sr_number          String?
  status             TicketInvoiceStatus @default(DRAFT)
  subtotal_mvr       Decimal             @db.Decimal(10, 2)
  tax_mvr            Decimal             @db.Decimal(10, 2)
  total_mvr          Decimal             @db.Decimal(10, 2)
  gst_rate           Decimal             @db.Decimal(5, 4)
  line_items         Json
  created_by_user_id String?
  issued_at          DateTime?
  paid_at            DateTime?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  payments           TicketPayment[]
  receipt            TicketReceipt?

  @@index([crm_ticket_id])
  @@map("ticket_invoices")
}

model TicketPayment {
  id                 String              @id @default(cuid())
  reference          String              @unique
  crm_ticket_id      String
  invoice_id         String?
  amount_mvr         Decimal             @db.Decimal(10, 2)
  subtotal_mvr       Decimal?            @db.Decimal(10, 2)
  tax_mvr            Decimal?            @db.Decimal(10, 2)
  currency           String              @default("MVR")
  status             TicketPaymentStatus @default(PENDING)
  bml_transaction_id String?
  bml_state          String?
  payment_url        String?
  line_items         Json
  created_by_user_id String?
  confirmed_at       DateTime?
  metadata           Json?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  invoice            TicketInvoice?      @relation(fields: [invoice_id], references: [id])
  receipt            TicketReceipt?

  @@index([crm_ticket_id])
  @@index([bml_transaction_id])
  @@index([invoice_id])
  @@map("ticket_payments")
}

enum TicketBillingDecision {
  UNDECIDED
  NOT_CHARGEABLE
  CHARGEABLE
}

model TicketBillingState {
  id                 String                @id @default(cuid())
  crm_ticket_id      String                @unique
  decision           TicketBillingDecision @default(UNDECIDED)
  decided_by_user_id String?
  decided_at         DateTime?
  notes              String?
  created_at         DateTime              @default(now())
  updated_at         DateTime              @updatedAt

  @@map("ticket_billing_states")
}

model TicketReceipt {
  id              String        @id @default(cuid())
  receipt_number  String        @unique
  invoice_id      String        @unique
  payment_id      String        @unique
  crm_ticket_id   String
  sr_number       String?
  subtotal_mvr    Decimal       @db.Decimal(10, 2)
  tax_mvr         Decimal       @db.Decimal(10, 2)
  amount_paid_mvr Decimal       @db.Decimal(10, 2)
  line_items      Json
  issued_at       DateTime      @default(now())
  snapshot        Json?
  invoice         TicketInvoice @relation(fields: [invoice_id], references: [id])
  payment         TicketPayment @relation(fields: [payment_id], references: [id])

  @@index([crm_ticket_id])
  @@map("ticket_receipts")
}

// ---------------------------------------------------------------------------
// Phase 2 — Inventory consumption & INCA provisioning (keyed on the CRM SR id)
// ---------------------------------------------------------------------------

model InventoryItem {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  category          String
  stock_uom         String
  consumption_uom   String
  /// Consumption units per stock unit, e.g. 1000 for a 1000 m cable roll.
  conversion_factor Decimal  @default(1) @db.Decimal(12, 4)
  serialized        Boolean  @default(false)
  allow_decimal     Boolean  @default(false)
  remarks_required  Boolean  @default(false)
  active            Boolean  @default(true)
  notes             String?
  sort_order        Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  consumptions    TicketInventoryConsumption[]
  stock_movements TechnicianStockMovement[]
  serial_units    SerialUnit[]

  @@map("inventory_items")
}

enum StockMovementType {
  ISSUE
  RETURN
}

enum StockReturnCondition {
  GOOD
  FAULTY
}

enum SerialUnitStatus {
  WITH_TECHNICIAN
  CONSUMED
  RETURNED
  FAULTY
}

/// Items the inventory team hands to (ISSUE) or takes back from (RETURN) a technician.
/// Quantities are in the item's consumption UOM; serialized items are one row per serial.
model TechnicianStockMovement {
  id                   String                @id @default(cuid())
  /// One issue/return slip; also the client idempotency key for that slip.
  batch_id             String
  type                 StockMovementType
  technician_user_id   String
  item_id              String
  item_name            String
  quantity             Decimal               @db.Decimal(12, 2)
  uom                  String
  serial_number        String?
  condition            StockReturnCondition?
  reference            String?
  notes                String?
  performed_by_user_id String
  created_at           DateTime              @default(now())

  item InventoryItem @relation(fields: [item_id], references: [id])

  @@index([technician_user_id, item_id])
  @@index([created_at])
  @@index([batch_id])
  @@index([serial_number])
  @@map("technician_stock_movements")
}

/// Where each serialized unit (ONT, router…) is right now; history is in the movements and consumptions.
model SerialUnit {
  id                 String           @id @default(cuid())
  serial_number      String           @unique
  item_id            String
  status             SerialUnitStatus
  technician_user_id String?
  consumption_id     String?          @unique
  issued_at          DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  item InventoryItem @relation(fields: [item_id], references: [id])

  @@index([technician_user_id, status])
  @@map("serial_units")
}

enum InventoryDeclarationType {
  USED
  NONE_USED
}

/// One per Service Request: the technician's "Inventory used / No inventory used" answer.
model TicketInventoryDeclaration {
  id                  String                   @id @default(cuid())
  crm_ticket_id       String                   @unique
  sr_number           String?
  declaration         InventoryDeclarationType
  declared_by_user_id String
  department          String?
  service_type        String?
  area                String?
  customer_name       String?
  declared_at         DateTime                 @default(now())
  updated_at          DateTime                 @updatedAt

  @@map("ticket_inventory_declarations")
}

enum InventoryConsumptionStatus {
  POSTED
  REVERSED
}

model TicketInventoryConsumption {
  id                          String                     @id @default(cuid())
  crm_ticket_id               String
  sr_number                   String?
  item_id                     String
  item_name                   String
  quantity                    Decimal                    @db.Decimal(12, 2)
  uom                         String
  serial_number               String?
  remarks                     String?
  technician_user_id          String
  department                  String?
  service_type                String?
  area                        String?
  customer_name               String?
  provisioning_transaction_id String?
  status                      InventoryConsumptionStatus @default(POSTED)
  /// Drawn from the technician's issued stock; older lines predate issuing and are not.
  stock_tracked               Boolean                    @default(false)
  idempotency_key             String?                    @unique
  posted_at                   DateTime                   @default(now())

  item        InventoryItem         @relation(fields: [item_id], references: [id])
  adjustments InventoryAdjustment[]

  @@index([crm_ticket_id])
  @@index([posted_at])
  @@index([technician_user_id])
  @@index([item_id])
  @@map("ticket_inventory_consumptions")
}

model InventoryAdjustment {
  id                   String   @id @default(cuid())
  consumption_id       String
  quantity_delta       Decimal  @db.Decimal(12, 2)
  reason               String
  requested_by_user_id String
  approved_by_user_id  String?
  created_at           DateTime @default(now())

  consumption TicketInventoryConsumption @relation(fields: [consumption_id], references: [id])

  @@index([consumption_id])
  @@map("inventory_adjustments")
}

enum ProvisioningAction {
  NEW_CONNECTION
  ONT_REPLACEMENT
  RELOCATION
  SIGNAL_CHECK
}

enum ProvisioningStatus {
  VALIDATING
  REGISTERING_ONT
  APPLYING_CONFIG
  WAITING_TODO
  VERIFYING
  SUCCEEDED
  FAILED
}

model ProvisioningTransaction {
  id                 String             @id @default(cuid())
  crm_ticket_id      String
  sr_number          String?
  action             ProvisioningAction
  status             ProvisioningStatus @default(VALIDATING)
  technician_user_id String
  /// Submitted form values; secrets (PPPoE password) are never stored.
  submitted          Json
  /// Terminal node, ONT serials, OLT/PON, package, optical readings, verification flags.
  result             Json?
  ont_serial         String?
  old_ont_serial     String?
  /// True when a new ONT was physically installed and must appear in inventory.
  installs_ont       Boolean            @default(false)
  failed_stage       String?
  error_message      String?
  attempts           Int                @default(1)
  started_at         DateTime           @default(now())
  finished_at        DateTime?
  updated_at         DateTime           @updatedAt

  steps ProvisioningStep[]

  @@index([crm_ticket_id])
  @@index([status])
  @@index([started_at])
  @@map("provisioning_transactions")
}

model ProvisioningStep {
  id             String   @id @default(cuid())
  transaction_id String
  attempt        Int
  stage          String
  ok             Boolean
  message        String
  detail         Json?
  created_at     DateTime @default(now())

  transaction ProvisioningTransaction @relation(fields: [transaction_id], references: [id])

  @@index([transaction_id])
  @@map("provisioning_steps")
}
