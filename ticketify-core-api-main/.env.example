DATABASE_URL=postgresql://user:password@localhost:5432/ticketify
# At least 32 random characters in production (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-secret-of-48-chars
# Access token lifetime (about one shift). Tokens are also revoked on logout / password change / deactivation.
JWT_EXPIRES_IN=12h

# CRM reporting database (ServiceRequests, ContactProfiles, Devices)
MONGO_URI=mongodb+srv://user:password@host/CRM?retryWrites=true&w=majority

CRM_BACKOFFICE_API_URL=https://your-crm.example/backoffice/v2
CRM_API_KEY=your-crm-api-key
SKIP_CRM_VALIDATION=false

# Comma-separated browser origins for admin panel (production)
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Customer review page (Next.js admin app)
CUSTOMER_REVIEW_BASE_URL=http://127.0.0.1:3000

# SMS (Ooredoo) — values were previously hardcoded in src/shared/ooredoo-sms/sms.service.ts
SMS_API_URL=https://o-papi1-lb01.ooredoo.mv/bulk_sms/v2
SMS_USERNAME=your-ooredoo-sms-username
SMS_ACCESS_KEY=your-ooredoo-access-key-base64
SMS_AUTH_BEARER=Bearer your-ooredoo-api-token

# development | production ("prod" is accepted and normalized to production)
NODE_ENV=development

# Security
# Signs customer review links so they cannot be forged (required in production)
FEEDBACK_LINK_SECRET=change-me-to-a-long-random-secret
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting)
TRUST_PROXY_HOPS=1
CRM_REQUEST_TIMEOUT_MS=30000
# Dev only: set false to reject legacy (payload-signed) BML webhooks outside production too
BML_ALLOW_LEGACY_WEBHOOK_SIGNATURE=true
# Initial passwords for `npm run seed` (seed refuses to run without them)
SEED_ADMIN_PASSWORD=
SEED_RND_PASSWORD=
SEED_FINANCE_PASSWORD=

# Comma-separated CRM team ids for auto-assign when no AUTO policies exist
AUTO_ASSIGN_TEAM_IDS=f9006884-5b7e-4513-89ef-86e14acf0b25,1b71e6bd-116b-4b54-854f-03e1d2d9fba6
# Background auto-assign interval when supervisor/admin enables the toggle (ms)
AUTO_ASSIGN_POLL_INTERVAL_MS=60000
# CRM user ids never picked for auto-assign (e.g. dev/test technicians)
AUTO_ASSIGN_EXCLUDE_CRM_USER_IDS=
# Auto-assign scoring: lower workload preferred; optional km penalty when ticket has lat/lon
AUTO_ASSIGN_WEIGHT_LOAD=10
AUTO_ASSIGN_WEIGHT_PROXIMITY=1
# Last Mile counts on operations board (ms)
LM_OPS_CACHE_MS=45000

# Finance — Ticketify is source of truth (not CRM)
TICKETIFY_GST_RATE=0.08
REGION_MALE_TEAM_ID=f9006884-5b7e-4513-89ef-86e14acf0b25
REGION_HULHUMALE_TEAM_ID=1b71e6bd-116b-4b54-854f-03e1d2d9fba6

# Public HTTPS base for BML webhooks (optional if BML_WEBHOOK_URL is set)
PUBLIC_API_BASE_URL=https://ticketify-api.example.mv
# Server URL technicians enter in Traccar Client. Defaults to PUBLIC_API_BASE_URL + /api/v1/tracking/traccar.
TRACCAR_SERVER_URL=
# Customer SMS pay links — must be reachable from mobile (use ngrok in dev: https://YOUR.ngrok-free.app/api/v1)
PAYMENT_SMS_LINK_BASE=
# Dev only: allow localhost links in SMS (laptop testing; not for real customers)
ALLOW_LOCALHOST_PAYMENT_LINKS=true

# BML Connect (Bank of Maldives) — same pattern as medianet-voucher
# Live BML: set true with credentials below. In development, invoice + customer SMS work without BML (short pay link via API).
BML_ENABLED=false
# Production only: allow invoice/SMS when BML is off (normally keep false)
BML_INVOICE_WITHOUT_GATEWAY=false
BML_API_BASE_URL=https://api.merchants.bankofmaldives.com.mv
BML_API_MODE=v1
# JWT from BML Connect portal — send as-is in Authorization (do NOT prefix "Bearer"; see medianet-voucher)
BML_AUTH_TOKEN=
# API key from the BML merchant portal. Required to verify BML webhooks (unsigned
# webhooks are rejected); also signs v1 create requests.
BML_API_KEY=
BML_APP_ID=
BML_DEVICE_ID=ticketify-api
BML_APP_VERSION=ticketify/1.0
BML_SIGN_METHOD=sha1
BML_PROVIDER=
BML_LOCALE=en
# Where BML sends the customer after paying: the PUBLIC HTTPS admin panel page.
# A localhost value only works on this computer — phones cannot return to it.
BML_REDIRECT_URL=https://ticketify-admin.example.mv/payments/return
# Defaults to PUBLIC_API_BASE_URL + /payments/webhooks/bml when empty.
BML_WEBHOOK_URL=
BML_REQUEST_TIMEOUT_MS=30000
BML_SEND_APP_ID_HEADER=false
# Background check of open payments against BML (covers missed webhooks). Keep on.
PAYMENT_RECONCILER_ENABLED=true

# Pre-close checks (inventory declared, provisioning done, signal). false = shown as warnings only.
PHASE2_CLOSURE_ENFORCED=true
# An ONT installed through INCA must be declared as a materials line before closing,
# even while PHASE2_CLOSURE_ENFORCED=false.
CLOSURE_ONT_INVENTORY_ENFORCED=true

# INCA OSS. dummy = built-in simulator; live = the INCA REST API (ONT search and registration
# today; subscriber steps report "not integrated" until added).
INCA_MODE=dummy
INCA_BASE_URL=https://172.17.9.2/api
# Dedicated INCA account for Ticketify; never a person's login.
# Wrap the password in single quotes: an unquoted # starts a comment and cuts it short.
INCA_USERNAME=
INCA_PASSWORD=''
# INCA uses a self-signed certificate. Save it once and pin it (no TLS checks are disabled):
#   openssl s_client -connect 172.17.9.2:443 </dev/null 2>/dev/null | openssl x509 > /etc/ssl/certs/inca.pem
#   openssl x509 -in /etc/ssl/certs/inca.pem -noout -fingerprint -sha256
INCA_TLS_CA_FILE=/etc/ssl/certs/inca.pem
INCA_TLS_FINGERPRINT=
INCA_TIMEOUT_MS=15000
INCA_MAX_CONCURRENT=4

# Push notifications (OneSignal dashboard > Settings > Keys & IDs)
ONE_SIGNAL_APP_ID=
ONE_SIGNAL_API_KEY=
